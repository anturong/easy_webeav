<Window x:Class="WebDAVConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AppTitle}" Height="650" Width="1100"
        Background="#0d1117" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0d1117"/>
            <Setter Property="Foreground" Value="#e6edf3"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e6edf3"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8b949e"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.8*"/>
            <ColumnDefinition Width="1.2*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Control Panel (2-column, Service Control full-width bottom) -->
        <Grid Grid.Column="0" Margin="10,10,5,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Card: Settings (top-left) -->
            <Border Background="#161b22" CornerRadius="8" Padding="15" Margin="0,0,5,5">
                <StackPanel>
                    <TextBlock Text="基本设置" Foreground="#58a6ff" FontWeight="Bold" FontSize="13" Margin="0,0,0,15"/>

                    <CheckBox x:Name="ChkHttp" Content="启用 HTTP" Checked="ToggleHttp" Unchecked="ToggleHttp"/>
                    <Grid Margin="0,10,0,15" x:Name="HttpPortPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HTTP 端口:"/>
                        <TextBox x:Name="TxtPort" Grid.Column="1"/>
                    </Grid>

                    <CheckBox x:Name="ChkHttps" Content="启用 HTTPS (自签名证书)" Checked="ToggleHttps" Unchecked="ToggleHttps"/>
                    <Grid Margin="0,10,0,15" x:Name="HttpsPanel" IsEnabled="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="HTTPS 端口:"/>
                        <TextBox x:Name="TxtHttpsPort" Grid.Column="1"/>
                    </Grid>

                    <TextBlock Text="共享目录" Margin="0,0,0,5"/>
                    <Grid Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="TxtRootDir"/>
                        <Button Grid.Column="1" Content="浏览..." Click="BrowseFolder"
                                Background="#21262d" Foreground="#e6edf3" BorderBrush="#30363d"
                                Margin="5,0,0,0" Padding="10,5"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Card: User Management (top-right) -->
            <Border Grid.Column="1" Background="#161b22" CornerRadius="8" Padding="15" Margin="5,0,0,5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="用户管理" Foreground="#58a6ff" FontWeight="Bold" FontSize="13" Margin="0,0,0,10"/>

                    <ListBox x:Name="LstUsers" Grid.Row="1" Background="#0d1117" Foreground="#e6edf3"
                             BorderBrush="#30363d" SelectionChanged="OnUserSelect" Margin="0,0,0,10"
                             Height="100"/>
                    <TextBlock Grid.Row="2" Text="用户名" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="3" x:Name="TxtUser" Margin="0,0,0,8"/>
                    <TextBlock Grid.Row="4" Text="密码" Margin="0,0,0,5"/>
                    <TextBox Grid.Row="5" x:Name="TxtPass" Margin="0,0,0,8"/>
                    <CheckBox Grid.Row="6" x:Name="ChkReadOnly" Content="只读 (不可删除/上传)"/>
                    <StackPanel Grid.Row="7" Orientation="Horizontal" Margin="0,10,0,0" HorizontalAlignment="Center">
                        <Button Content="添加" Click="AddUser" Background="#3fb950" Foreground="#0d1117" FontWeight="Bold" Width="65" Margin="0,0,5,0"/>
                        <Button Content="更新" Click="UpdateUser" Background="#58a6ff" Foreground="#0d1117" FontWeight="Bold" Width="65" Margin="0,0,5,0"/>
                        <Button Content="删除" Click="DeleteUser" Background="#f85149" Foreground="#0d1117" FontWeight="Bold" Width="65"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card: Service Control (full-width bottom, fills remaining space) -->
            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#161b22" CornerRadius="8" Padding="20" Margin="0,5,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="服务控制" Foreground="#58a6ff" FontWeight="Bold" FontSize="14" Margin="0,0,0,16"/>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                        <TextBlock Text="访问:" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="14"/>
                        <TextBlock x:Name="LnkHttp" Foreground="#3fb950" Cursor="Hand" FontSize="14" MouseDown="OpenLink" Margin="0,0,16,0"/>
                        <TextBlock x:Name="LnkHttps" Foreground="#3fb950" Cursor="Hand" FontSize="14" MouseDown="OpenLink" Margin="0,0,15,0" Visibility="Collapsed"/>
                    </StackPanel>

                    <Button Grid.Row="2" Content="保存配置" Click="SaveConfig" Background="#21262d" Foreground="#e6edf3" BorderBrush="#30363d" Padding="12,8" HorizontalAlignment="Stretch" Margin="0,0,0,12" FontSize="13"/>

                    <Grid Grid.Row="3" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="重启服务" Click="RestartService" Background="#58a6ff" Foreground="#0d1117" FontWeight="Bold" Padding="10,8" Margin="0,0,4,0" FontSize="13"/>
                        <Button Grid.Column="1" Content="安装服务" Click="InstallService" Background="#3fb950" Foreground="#0d1117" FontWeight="Bold" Padding="10,8" Margin="4,0" FontSize="13"/>
                        <Button Grid.Column="2" Content="卸载服务" Click="UninstallService" Background="#f85149" Foreground="#0d1117" FontWeight="Bold" Padding="10,8" Margin="4,0,0,0" FontSize="13"/>
                    </Grid>
                </Grid>
            </Border>

        </Grid>

        <!-- Right: Log Console -->
        <Grid Grid.Column="1" Background="#010409" Margin="5,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="操作日志" Foreground="#8b949e" FontWeight="Bold" FontSize="14" Margin="5"/>
            <RichTextBox Grid.Row="1" x:Name="LogConsole"
                         Background="Transparent" Foreground="#e6edf3"
                         BorderThickness="0" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="13"
                         VerticalScrollBarVisibility="Auto" Margin="5">
                <FlowDocument PagePadding="0" LineHeight="1.2"/>
            </RichTextBox>
        </Grid>
    </Grid>
</Window>
