<Window x:Class="WebDAVConfigurator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding AppTitle}" Height="650" Width="1100"
        Background="#0d1117" WindowStartupLocation="CenterScreen"
        ResizeMode="CanMinimize">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#0d1117"/>
            <Setter Property="Foreground" Value="#e6edf3"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="FontFamily" Value="Consolas"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#e6edf3"/>
            <Setter Property="Margin" Value="0,5"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8b949e"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2.2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Left: Log Console -->
        <Grid Grid.Column="0" Background="#010409" Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="操作日志" Foreground="#8b949e" FontWeight="Bold" FontSize="14" Margin="5"/>
            <RichTextBox Grid.Row="1" x:Name="LogConsole"
                         Background="Transparent" Foreground="#e6edf3"
                         BorderThickness="0" IsReadOnly="True"
                         FontFamily="Consolas" FontSize="13"
                         VerticalScrollBarVisibility="Auto" Margin="5">
                <FlowDocument PagePadding="0" LineHeight="1.2"/>
            </RichTextBox>
        </Grid>

        <!-- Right: Control Panel -->
        <ScrollViewer Grid.Column="1" Margin="0,10,10,10">
            <StackPanel>

                <!-- Card: Settings -->
                <Border Background="#161b22" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="基本设置" Foreground="#58a6ff" FontWeight="Bold" FontSize="13" Margin="0,0,0,15"/>

                        <TextBlock Text="监听端口" Margin="0,0,0,5"/>
                        <TextBox x:Name="TxtPort" Margin="0,0,0,15"/>

                        <TextBlock Text="共享目录" Margin="0,0,0,5"/>
                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="TxtRootDir"/>
                            <Button Grid.Column="1" Content="浏览..." Click="BrowseFolder"
                                    Background="#21262d" Foreground="#e6edf3" BorderBrush="#30363d"
                                    Margin="5,0,0,0" Padding="10,5"/>
                        </Grid>

                        <CheckBox x:Name="ChkHttps" Content="启用 HTTPS (自签名证书)" Checked="ToggleHttps" Unchecked="ToggleHttps"/>
                        <Grid Margin="0,10,0,0" x:Name="HttpsPanel" IsEnabled="False">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="HTTPS 端口:"/>
                            <TextBox x:Name="TxtHttpsPort" Grid.Column="1"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Card: User Management -->
                <Border Background="#161b22" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                    <StackPanel>
                        <TextBlock Text="用户管理" Foreground="#58a6ff" FontWeight="Bold" FontSize="13" Margin="0,0,0,15"/>

                        <ListBox x:Name="LstUsers" Height="100" Background="#0d1117" Foreground="#e6edf3"
                                 BorderBrush="#30363d" SelectionChanged="OnUserSelect" Margin="0,0,0,10"/>
                        <TextBlock Text="用户名"/>
                        <TextBox x:Name="TxtUser" Margin="0,0,0,10"/>
                        <TextBlock Text="密码"/>
                        <TextBox x:Name="TxtPass" Margin="0,0,0,10"/>

                        <CheckBox x:Name="ChkReadOnly" Content="设为只读 (不可删除/上传)"/>
                        <StackPanel Orientation="Horizontal" Margin="0,15,0,0" HorizontalAlignment="Center">
                            <Button Content="添加" Click="AddUser" Background="#3fb950" Foreground="#0d1117" FontWeight="Bold" Width="60" Margin="0,0,5,0"/>
                            <Button Content="更新" Click="UpdateUser" Background="#58a6ff" Foreground="#0d1117" FontWeight="Bold" Width="60" Margin="0,0,5,0"/>
                            <Button Content="删除" Click="DeleteUser" Background="#f85149" Foreground="#0d1117" FontWeight="Bold" Width="60"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Card: Service Control -->
                <Border Background="#161b22" CornerRadius="8" Padding="15">
                    <StackPanel>
                        <TextBlock Text="服务控制" Foreground="#58a6ff" FontWeight="Bold" FontSize="13" Margin="0,0,0,15"/>
                        <TextBlock Text="访问地址:" Margin="0,0,0,5"/>
                        <TextBlock x:Name="LnkHttp" Foreground="#3fb950" Cursor="Hand" MouseDown="OpenLink" Margin="0,0,0,5"/>
                        <TextBlock x:Name="LnkHttps" Foreground="#3fb950" Cursor="Hand" MouseDown="OpenLink" Margin="0,0,0,15" Visibility="Collapsed"/>

                        <Button Content="保存配置" Click="SaveConfig" Background="#21262d" Foreground="#e6edf3" BorderBrush="#30363d" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="安装服务" Click="InstallService" Background="#3fb950" Foreground="#0d1117" FontWeight="Bold" Margin="0,0,5,0"/>
                            <Button Content="卸载服务" Click="UninstallService" Background="#f85149" Foreground="#0d1117" FontWeight="Bold" Grid.Column="1"/>
                        </Grid>
                        <Button Content="重启服务" Click="RestartService" Background="#58a6ff" Foreground="#0d1117" FontWeight="Bold" Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
